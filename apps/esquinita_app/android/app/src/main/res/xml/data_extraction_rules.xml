<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0004: no cloud backup and no device-to-device transfer (Android 12+).
     The encrypted database without its Keystore key is useless elsewhere,
     and a copy must never leave the tablet. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
