# Copia este archivo a .env y completa con valores reales. Nunca subas .env al repositorio.
POSTGRES_USER=esquinita
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=esquinita
DATABASE_URL=postgres://esquinita:cambia-esto@localhost:5432/esquinita?sslmode=disable
# Base aparte para las pruebas del servidor (se borra en cada corrida).
TEST_DATABASE_URL=postgres://esquinita:cambia-esto@localhost:5432/esquinita_test?sslmode=disable
# Dirección donde escucha el servidor. Vacío = solo este equipo (127.0.0.1).
# Para la tablet: la IP privada de la PC en la red local, p. ej. 192.168.1.50.
SERVER_HOST=
JWT_SECRET=genera-un-valor-aleatorio-largo
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
APP_TIMEZONE=America/Lima
# decolecta.com (consulta DNI/RUC, ADR-0003). Solo en el servidor, nunca en la app.
DECOLECTA_API_TOKEN=sk_ficticio_cambia-esto
